{
  "extends": "@laboperator-gmbh/config/tsconfig",
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@fixtures/*": ["./src/__tests__/fixtures/*"]
    },
    "rootDir": "src",
    "strictNullChecks": true
  },
  "include": ["src/**/*"]
}
